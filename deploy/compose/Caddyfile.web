# A relay restart or upgrade makes requests and socket reconnects wait for the
# new container instead of failing with 502.
(relay) {
	reverse_proxy relay:3000 {
		lb_try_duration 30s
		lb_try_interval 250ms
	}
}

{$BUZZ_DOMAIN} {
	encode zstd gzip

	# Relay surfaces that no client needs through this proxy. Workflow webhooks
	# (/hooks/*) stay open: each one checks its own secret header.
	@internal path /internal/* /operator/* /api/admin/* /api/nip-fi/* /_mesh/*
	handle @internal {
		respond 404
	}

	# The page CSP ships as a meta tag pinned to each build's inline scripts;
	# frame-ancestors only works as a header.
	header {
		Content-Security-Policy "frame-ancestors 'none'"
		Permissions-Policy "camera=(self), microphone=(self), geolocation=()"
		Referrer-Policy "no-referrer"
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}

	handle /pair {
		reverse_proxy pairing:5000
	}

	# Browser push registration; relay wake delivery stays internal.
	handle /webpush/* {
		reverse_proxy webpush:8080
	}

	@relay_socket {
		header Connection *Upgrade*
		header Upgrade websocket
	}
	handle @relay_socket {
		import relay
	}

	@nip11 header Accept *application/nostr+json*
	handle @nip11 {
		import relay
	}

	@web_asset {
		not path /
		file {
			root /srv/buzz/web
			try_files {path}
		}
	}
	handle @web_asset {
		@revalidate path /sw.js /manifest.webmanifest
		header @revalidate Cache-Control "no-cache"
		# Content-hashed build output; only existing files, so a missing
		# chunk is never cached as immutable.
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		root * /srv/buzz/web
		file_server
	}

	# Relay HTML (join policy pages) and API stay on the relay.
	@web_route {
		header Accept *text/html*
		not path /api/* /media/* /.well-known/* /git/*
	}
	handle @web_route {
		header Cache-Control "no-cache"
		root * /srv/buzz/web
		rewrite * /index.html
		file_server
	}

	handle {
		import relay
	}
}
